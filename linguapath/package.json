{
  "name": "linguapath",
  "version": "1.0.0",
  "private": true,
  "description": "LinguaPath — a gamified language learning web app",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "node scripts/db-push.mjs",
    "db:studio": "drizzle-kit studio",
    "content:build": "node scripts/content/build.mjs",
    "db:seed": "node scripts/seed.mjs",
    "setup": "npm run content:build && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.447.0",
    "next": "^14.2.18",
    "next-auth": "^4.24.10",
    "next-themes": "^0.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^20.16.13",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
